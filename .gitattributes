# Shell scripts and Docker files MUST keep LF line endings: a CRLF deploy.sh
# fails on Linux with "'bash\r': No such file or directory".
*.sh text eol=lf
Dockerfile text eol=lf
*.mjs text eol=lf
# .env.example is copied to .env and then `source`d by deploy.sh — a CR would end up
# inside values (PUBLIC_ORIGIN gains a trailing \r that silently breaks the client's
# origin comparison), and `text` alone would hand Windows checkouts CRLF here.
.env.example text eol=lf
.env text eol=lf
*.yml text
*.yaml text
*.json text
*.md text
*.ts text
*.tsx text
*.js text
*.css text
*.html text
