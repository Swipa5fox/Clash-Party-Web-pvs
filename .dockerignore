# Build context for deploy/party/Dockerfile (docker build from the repo root).
# Keep everything the builder needs: package.json, pnpm-lock.yaml, src/,
# scripts/, extra/files geo assets. Drop everything regenerable
# or machine-local.

# VCS / IDE
.git
.gitignore
.idea
.vscode

# Local toolchain state (regenerated inside the builder)
node_modules
out
dist
release

# Windows / darwin binaries — the linux container never uses them.
# (*.node must NOT be excluded wholesale: sysproxy.linux-x64-gnu.node is needed.)
extra/sidecar/*.exe
extra/sidecar/*win32*.node
extra/sidecar/*darwin*.node

# Desktop packaging assets — the linux container never uses them.
deploy/build

# Local deployment state / secrets
deploy/gateway/.env
deploy/gateway/.env.bak
deploy/gateway/data
deploy/gateway/gateway.db
deploy/gateway/gateway.db-shm
deploy/gateway/gateway.db-wal
