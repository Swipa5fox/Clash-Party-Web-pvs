# Build context for deploy/party/Dockerfile (docker build from the repo root).
# Keep everything the builder needs: package.json, pnpm-lock.yaml,
# pnpm-workspace.yaml, src/, scripts/, extra/ (geo assets + pre-synced linux
# mihomo sidecar). Drop everything regenerable or machine-local.

# VCS / IDE
.git
.gitignore
.idea
.vscode

# Local toolchain state (regenerated inside the builder)
node_modules
dist
out
release

# Windows-only sidecar binaries — the linux container never uses them.
extra/sidecar/*.exe
extra/sidecar/*win32*.node
extra/sidecar/*darwin*.node

# Desktop packaging assets — the linux container never uses them.
deploy/build

# Local deployment state / secrets
deploy/gateway/.env
deploy/gateway/.env.bak
deploy/gateway/data
deploy/gateway/gateway.db
deploy/gateway/gateway.db-shm
deploy/gateway/gateway.db-wal
