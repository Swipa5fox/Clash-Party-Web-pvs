# Gateway public origin as reachable by LAN clients (plain HTTP, IP:port). Required.
# This is written into /.well-known/cpx-gateway and must be the exact origin the
# Clash Party client uses to reach this server, e.g. http://192.168.1.100:8080
PUBLIC_ORIGIN=http://192.168.1.100:8080

# Default per-user device limit for `cpx-admin add-user` (override per user with --limit).
DEVICE_LIMIT_DEFAULT=3

# ---- Clash Party Web UI (party container, port 3999) ----
# Auth token for the Web UI: open http://<host>:3999/?token=<value>.
# deploy.sh generates a random one on first run; change it here any time
# (restart with: docker compose up -d party).
CP_WEB_TOKEN=change-me-lan-token
# Host-side port of the Web UI (container listens on 3999).
# PARTY_WEB_PORT=3999

# ---- Advanced (sensible defaults; uncomment only to override) ----
# Upstream subscription fetch timeout (ms) and max size (bytes)
# SUB_TIMEOUT_MS=30000
# SUB_MAX_BYTES=10485760
# Pending nonces kept per device
# NONCE_POOL_MAX=8
# Login attempts allowed per IP per window
# LOGIN_MAX=10
# LOGIN_WINDOW_MS=60000
# Set to "true" to retire this gateway: /challenge and /config return 410 gateway_retired
# RETIRED=false
# Path (inside the container) to a private CA cert for the subscription origin
# ORIGIN_CA_FILE=

# ---- mihomo control panel / API proxy (single-port access via the gateway) ----
# The gateway proxies every non-gateway path (panel /ui, REST, WebSocket) to the
# party container's mihomo controller over the compose network, so
# http://<host>:8080/ also serves a panel. Defaults fit docker-compose.
# MIHOMO_API_URL=http://party:9090
# Optional defense-in-depth: if the controlled mihomo config sets a controller
# secret (Web UI: 设置 -> Mihomo 内核), mirror it here for proxied requests.
# MIHOMO_API_SECRET=

# ---- LAN proxy (party container's mihomo core; host-side port) ----
# Mixed port: one port serving both HTTP and SOCKS5 clients.
# Subscriptions for the core are managed in the Web UI, not in files.
# MIHOMO_MIXED_PORT=7890
# AU 通用口(17891 AU 全局 / 8888+8889 JP 在 docker-compose.override.yml 里映射)。
# 端口行为由 mihomo-lines skill 写入的覆写提供(不跑脚本时该口无人监听)。
# Comment out its docker-compose.yml line if unused.
# AU_PORT=17890
# To hide a port you do not need, comment out its line in docker-compose.yml.
