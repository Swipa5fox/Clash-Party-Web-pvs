{
  "name": "mihomo-party",
  "version": "1.3.1",
  "description": "Clash Party Web PVS — LAN Direct-Access Rebuild",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "mihomo-party-org",
  "license": "GPL-3.0-only",
  "homepage": "https://clashparty.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swipa5fox/Clash-Party-Web-pvs.git"
  },
  "bugs": {
    "url": "https://github.com/Swipa5fox/Clash-Party-Web-pvs/issues"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --list-different .",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "review": "pnpm run format:check && pnpm run lint:check && pnpm run typecheck",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "prepare": "node scripts/prepare.mjs",
    "prepare:dev": "node scripts/update-version.mjs && node scripts/prepare.mjs",
    "updater": "node scripts/updater.mjs",
    "checksum": "node scripts/checksum.mjs",
    "telegram": "node scripts/telegram.mjs release",
    "telegram:dev": "node scripts/telegram.mjs dev",
    "build": "vite build && node scripts/build-server.mjs",
    "build:tarball": "pnpm run build && node scripts/pack-tarball.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.6.0",
    "age-encryption": "^0.3.0",
    "axios": "^1.19.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "i18next": "^26.3.6",
    "qrcode.react": "^4.2.0",
    "validator": "^13.15.35",
    "webdav": "^5.10.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@eslint/js": "9.39.5",
    "@heroui/react": "^2.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "chart.js": "^4.5.1",
    "cron-validator": "^1.4.0",
    "dayjs": "^1.11.21",
    "driver.js": "^1.6.0",
    "eslint": "9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "meta-json-schema": "^1.19.29",
    "monaco-yaml": "^5.5.1",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-monaco-editor": "^0.59.0",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.11",
    "swr": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "types-pac": "^1.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "^7.3.5",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "4.1.10",
    "esbuild": "^0.27.4",
    "tsx": "^4.20.0",
    "tar": "^7.4.0"
  },
  "packageManager": "pnpm@11.8.0"
}
